# ==============================================================================
# TorangGo — Environment Configuration Template
# Working brand: TorangGo (provisional)
# Phase: 1A — Project & Monorepo Foundation
# ==============================================================================

# Backend API
# Backend API Foundation (Phase 1B)
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
API_DOCS_ENABLED=true
BODY_LIMIT=1mb
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100

# Local Infrastructure (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=toranggo_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/toranggo_dev

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Admin Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Mobile Apps (Expo)
EXPO_PUBLIC_API_URL=http://localhost:4000
