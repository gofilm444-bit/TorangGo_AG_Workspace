{
    "name": "backend",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "build": "tsc",
        "dev": "node dist/main.js",
        "start": "node dist/main.js",
        "lint": "eslint src",
        "typecheck": "tsc --noEmit",
        "test": "tsc && node scripts/run-tests.mjs",
        "openapi:export": "node dist/scripts/export-openapi.js",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "node dist/database/scripts/migrate.js"
    },
    "dependencies": {
        "@nestjs/common": "^12.0.1",
        "@nestjs/core": "^12.0.1",
        "@nestjs/platform-express": "^12.0.1",
        "@nestjs/swagger": "^12.0.1",
        "@nestjs/throttler": "^6.5.0",
        "@platform/config": "workspace:*",
        "@platform/shared-types": "workspace:*",
        "@platform/utils": "workspace:*",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "cookie-parser": "^1.4.7",
        "drizzle-orm": "^0.45.2",
        "express": "^5.0.0",
        "helmet": "^8.3.0",
        "ioredis": "^5.4.2",
        "jsonwebtoken": "^9.0.2",
        "pg": "^8.23.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "swagger-ui-express": "^5.0.1",
        "zod": "^3.24.2",
        "argon2": "^0.41.1"
    },
    "devDependencies": {
        "@nestjs/testing": "^12.0.1",
        "@types/cookie-parser": "^1.4.8",
        "@types/express": "^5.0.0",
        "@types/ioredis": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.8",
        "@types/node": "^22.13.9",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^6.0.3",
        "drizzle-kit": "^0.31.10",
        "supertest": "^7.2.2",
        "typescript": "^5.8.2"
    },
    "type": "module"
}
